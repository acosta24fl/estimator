# Copy to .env and fill in. Never commit the real .env.

# Telegram: create a bot with @BotFather, then message it once so it can reply.
# Get the chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Shared secret TradingView must include in every alert body.
# An ngrok URL is public — without this, anyone who finds it can inject prices.
TV_WEBHOOK_SECRET=
